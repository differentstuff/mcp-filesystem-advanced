{
  "name": "@differentstuff/mcp-filesystem-advanced",
  "version": "1.0.0",
  "description": "Enhanced MCP server for filesystem access with Reaktionsnetzwerk-inspired operation tracking, auto-parent creation, and conflict detection",
  "license": "MIT",
  "author": "Jean-Marie Heck",
  "type": "module",
  "bin": {
    "mcp-filesystem-advanced": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && shx chmod +x dist/*.js",
    "watch": "tsc --watch",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
"dependencies": {
    "fastmcp": "3.34.0",
    "zod": "3.25.28",
    "diff": "8.0.2",
    "minimatch": "10.2.5",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@types/diff": "8.0.0",
    "@types/node": "24.0.0",
    "shx": "0.4.0",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}